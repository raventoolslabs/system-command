# .env DE PRUEBA para el simulador Docker. NUNCA es el .env real del repo
# (que sigue intacto en la raíz del host, con valores de producción) — este
# archivo se monta de solo lectura ÚNICAMENTE dentro del contenedor, sobre
# /opt/code/system-command/.env (ver docker-compose.yml).
EXPECTED_PORTS="22"
DOCKER_ALLOWED_PORTS="8080/tcp"
HOST_ALLOWED_PORTS="80/tcp"
NTP_SERVER="pool.ntp.org"
