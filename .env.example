# Puertos esperados que security_check.sh audita como expuestos
# públicamente. NO dupliques aquí los puertos ya declarados en
# DOCKER_ALLOWED_PORTS o HOST_ALLOWED_PORTS — el chequeo los une
# automáticamente con estos. Pon solo los que no gestione ninguno de los
# dos scripts de firewall (p.ej. 22, que tiene su propia regla fija con
# rate-limit fuera de su control, y 41641 de Tailscale).
EXPECTED_PORTS="22 41641"

# Puertos que Docker puede reenviar hacia contenedores vía DOCKER-USER
# (ver scripts/firewall/docker-user-firewall.sh). Formato: puerto[:puerto]/tcp|udp
DOCKER_ALLOWED_PORTS="53/tcp 53/udp 9000:9001/tcp"

# Puertos de servicios propios del host, aceptados en la cadena input
# (tabla inet filter) de nftables (ver scripts/firewall/host-firewall.sh).
# SSH (22) no se declara aquí: tiene su propia regla fija con rate-limit
# en /etc/nftables.conf, fuera del control de este script. Mismo formato
# que DOCKER_ALLOWED_PORTS: puerto[:puerto]/tcp|udp
HOST_ALLOWED_PORTS="80/tcp 443/tcp"

# Servidor NTP contra el que security_check.sh verifica la sincronización
# horaria (más allá de comprobar que el reloj está sincronizado en
# general). No hay un valor por defecto correcto para cualquier
# despliegue — cada instalación debe declarar aquí el suyo. Ejemplo real
# usado en despliegues de la Armada española:
NTP_SERVER="hora.roa.es"